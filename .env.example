# TypeSafe (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest

# incident.io management API (https://app.incident.io/~/settings/api-keys)
# Needs: view alerts and incidents, manage alert tags, manage incident alerts.
INCIDENTIO_API_KEY=
# INCIDENTIO_BASE_URL=https://api.incident.io

# Webhook endpoint signing secret (Settings -> Webhooks -> your endpoint), whsec_...
INCIDENTIO_WEBHOOK_SECRET=

# Only for `triage --forward-to-incidentio`: an HTTP alert source's config id and token.
# INCIDENTIO_ALERT_SOURCE_CONFIG_ID=
# INCIDENTIO_ALERT_SOURCE_TOKEN=

# SIGNALMAN_ADDR=127.0.0.1:8080
# RUST_LOG=info

# Backstage (optional). Backend URL without /api and a backend.auth.externalAccess static token.
# BACKSTAGE_BASE_URL=https://backstage.example.com
# BACKSTAGE_TOKEN=
# BACKSTAGE_NAMESPACE=default
# BACKSTAGE_NOTIFY=false
# SIGNALMAN_COMPONENT_KEYS=component,service,app,application
