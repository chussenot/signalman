# Secrets: environment only, never in the configuration file.
# TypeSafe (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
# incident.io management API (https://app.incident.io/~/settings/api-keys)
# Needs: view alerts and incidents, manage alert tags, manage incident alerts, manage alert notes.
INCIDENTIO_API_KEY=
# Webhook endpoint signing secret (Settings -> Webhooks -> your endpoint), whsec_...
INCIDENTIO_WEBHOOK_SECRET=
# Backstage backend.auth.externalAccess static token (optional for unauthenticated backends).
# BACKSTAGE_TOKEN=
# Only for `triage --forward-to-incidentio`: an HTTP alert source's config id and token.
# INCIDENTIO_ALERT_SOURCE_CONFIG_ID=
# INCIDENTIO_ALERT_SOURCE_TOKEN=

# Everything else belongs in a configuration file (examples/config/signalman.toml,
# docs/configuration.md). Environment variables override the file when set:
# SIGNALMAN_CONFIG=./signalman.toml
# SIGNALMAN_ADDR=127.0.0.1:8080
# TYPESAFE_DEFAULT_MODEL=jev-latest
# BACKSTAGE_BASE_URL=https://backstage.example.com
# BACKSTAGE_NOTIFY=false
# SIGNALMAN_NOTE=true
# SIGNALMAN_RELATED_WINDOW_MINUTES=30
# RUST_LOG=info
