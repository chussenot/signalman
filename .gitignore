/target
**/*.rs.bk

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
# Per-machine marker of the last JSONL auto-import (size and mtime of issues.jsonl)
.beads/.auto-import-issues.jsonl

# Local secrets (loaded by mise from .env; template lives in .env.example)
.env
.env.*
!.env.example

# mise
.mise.local.toml
mise.local.toml
